{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/prb/.local/bin/uv run python /Users/prb/.codex/hooks/UserPromptSubmit/copy_prompt_to_clipboard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/Users/prb/.codex/hooks/AgentSessionStatus/agent_session_status.py hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/prb/.codex/hooks/AgentSessionStatus/agent_session_status.py hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/prb/.codex/hooks/AgentSessionStatus/agent_session_status.py hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
