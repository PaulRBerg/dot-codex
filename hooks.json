{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "ai-notify event codex",
            "timeout": 1,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "ai-notify event codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "ai-coord hook codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/prb/.local/bin/uv run python /Users/prb/.codex/hooks/PreToolUse/git_guard.py",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "ai-notify event codex",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^request_user_input$"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "ai-coord hook codex",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ai-coord hook codex",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/prb/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ai-coord hook codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "ai-notify event codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "ai-coord hook codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "ai-coord hook codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/prb/.local/bin/uv run python /Users/prb/.codex/hooks/UserPromptSubmit/copy_prompt_to_clipboard.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "additionalContextLimit": 200,
            "command": "ai-coord hook codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "ai-notify event codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
