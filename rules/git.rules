# Prompt before force-deleting a git branch.
prefix_rule(
    pattern = [["git"], ["branch"], ["-D"]],
    decision = "prompt",
    justification = "`git branch -D` force-deletes a branch; verify it is merged or intentionally disposable.",
    match = [
        "git branch -D old-work",
    ],
    not_match = [
        "git branch -d merged-work",
        "git branch --list",
    ],
)

# Prompt before discarding worktree changes via `git checkout --`.
prefix_rule(
    pattern = [["git"], ["checkout"], ["--"]],
    decision = "prompt",
    justification = "`git checkout -- <path>` discards worktree changes; inspect the diff and confirm intent first.",
    match = [
        "git checkout -- src/app.ts",
    ],
    not_match = [
        "git checkout main",
        "git checkout -b feature",
    ],
)

# Prompt before deleting untracked files with `git clean`.
prefix_rule(
    pattern = [["git"], ["clean"], ["-f", "-ff", "-fd", "-df", "-fdx", "-fxd", "-xdf"]],
    decision = "prompt",
    justification = "`git clean` deletes untracked files; preview with `git clean -nd` and confirm intent first.",
    match = [
        "git clean -fd",
        "git clean -fdx",
    ],
    not_match = [
        "git clean -nd",
        "git status --short",
    ],
)

# Prompt before repository-wide history filtering.
prefix_rule(
    pattern = [["git"], ["filter-repo", "filter-branch"]],
    decision = "prompt",
    justification = "History-rewriting git commands need explicit intent and a clean understanding of downstream impact.",
    match = [
        "git filter-repo --path secrets.txt --invert-paths",
        "git filter-branch --tree-filter 'rm secrets.txt'",
    ],
    not_match = [
        "git rebase main",
        "git rebase --continue",
        "git rebase --skip",
        "git rebase --abort",
        "git rebase --quit",
        "git rebase --help",
        "git merge main",
        "git log --oneline",
    ],
)

# Ordinary and interactive rebases have no blanket approval rule.
# Guard risky options immediately after rebase or its interactive flag. Prefix
# matching does not cover arbitrary option order, aliases, or Git config defaults.
for rebase_command in ["git rebase", "git rebase -i", "git rebase --interactive"]:
    prefix_rule(
        pattern = rebase_command.split(" ") + [[
            "--root", "--autostash", "--update-refs",
            "-sours", "--strategy=ours",
            "-Xours", "-Xtheirs", "--strategy-option=ours", "--strategy-option=theirs",
        ]],
        decision = "prompt",
        justification = "Review rebases that rewrite from the root, stash shared work, move other branches, or discard changes through a merge strategy.",
        match = [
            rebase_command + " --root",
            rebase_command + " --autostash main",
            rebase_command + " --update-refs main",
            rebase_command + " -sours main",
            rebase_command + " --strategy=ours main",
            rebase_command + " -Xours main",
            rebase_command + " -Xtheirs main",
            rebase_command + " --strategy-option=ours main",
            rebase_command + " --strategy-option=theirs main",
        ],
        not_match = [
            rebase_command + " main",
            rebase_command + " --onto main old-base feature",
            rebase_command + " --no-autostash main",
            rebase_command + " --no-update-refs main",
            rebase_command + " --strategy=ort main",
        ],
    )
    prefix_rule(
        pattern = rebase_command.split(" ") + [["-s", "--strategy"], ["ours"]],
        decision = "prompt",
        justification = "The ours rebase strategy discards every replayed patch.",
        match = [
            rebase_command + " -s ours main",
            rebase_command + " --strategy ours main",
        ],
        not_match = [
            rebase_command + " -s ort main",
            rebase_command + " --strategy ort main",
        ],
    )
    prefix_rule(
        pattern = rebase_command.split(" ") + [["-X", "--strategy-option"], ["ours", "theirs"]],
        decision = "prompt",
        justification = "Favoring one side automatically discards the other side of conflicting changes.",
        match = [
            rebase_command + " -X ours main",
            rebase_command + " -X theirs main",
            rebase_command + " --strategy-option ours main",
            rebase_command + " --strategy-option theirs main",
        ],
        not_match = [
            rebase_command + " -X find-renames main",
        ],
    )

# Prompt before discarding local changes with `git reset --hard`.
prefix_rule(
    pattern = [["git"], ["reset"], ["--hard"]],
    decision = "prompt",
    justification = "`git reset --hard` discards local changes; inspect the worktree and confirm intent first.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
        "git reset --mixed HEAD~1",
    ],
)

# Prompt before discarding worktree changes via `git restore`.
prefix_rule(
    pattern = [["git"], ["restore"], [".", "--worktree", "--source"]],
    decision = "prompt",
    justification = "`git restore` can discard worktree changes; inspect the diff and confirm intent first.",
    match = [
        "git restore .",
        "git restore --worktree src/app.ts",
        "git restore --source HEAD~1 src/app.ts",
    ],
    not_match = [
        "git restore --staged src/app.ts",
        "git diff src/app.ts",
    ],
)
