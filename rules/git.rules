# Forbid tree-wide git commands that sweep other agents' uncommitted work; mirrors the Claude deny list.
# Prefix matching covers only options directly after the subcommand, not arbitrary option order or aliases;
# hooks/PreToolUse/git_guard.py checks the same commands with options in any order.
prefix_rule(
    pattern = [["git"], ["add"], ["-A", "--all", "."]],
    decision = "forbidden",
    justification = "`git add -A`/`--all`/`.` stages every change in the shared worktree, including other agents' uncommitted work; stage explicit paths you edited instead.",
    match = [
        "git add -A",
        "git add --all",
        "git add .",
    ],
    not_match = [
        "git add src/app.ts",
        "git add -p src/app.ts",
        "git status --short",
    ],
)

prefix_rule(
    pattern = [["git"], ["commit"], ["-a", "-am", "--all"]],
    decision = "forbidden",
    justification = "`git commit -a`/`--all` stages every tracked modification in the shared worktree, including other agents' work; stage explicit paths you edited and commit with `ai-commit`.",
    match = [
        "git commit -a -m msg",
        "git commit -am msg",
        "git commit --all -m msg",
    ],
    not_match = [
        "git commit -m msg",
        "git commit --amend",
    ],
)

# Prefix rules cannot anchor at the end of a command, so a `git stash` rule would also block `git stash list/show`.
# This rule forbids the explicit stash-creating forms; hooks/PreToolUse/git_guard.py denies bare `git stash`.
prefix_rule(
    pattern = [["git"], ["stash"], [
        "push", "save", "clear", "--",
        "-a", "--all", "-k", "--keep-index", "--no-keep-index", "-m", "--message",
        "-p", "--patch", "-q", "--quiet", "-S", "--staged", "-u", "--include-untracked",
    ]],
    decision = "forbidden",
    justification = "`git stash` moves other agents' uncommitted work into a shared stash; read-only `git stash list` and `git stash show` stay available.",
    match = [
        "git stash push -m wip",
        "git stash save wip",
        "git stash -u",
        "git stash -m wip",
        "git stash clear",
    ],
    not_match = [
        "git stash list",
        "git stash show -p",
        "git reflog show stash",
        "git status --short",
    ],
)

# Prompt before force-pushing, which rewrites remote history.
for push_command in ["git push", "git push origin"]:
    prefix_rule(
        pattern = push_command.split(" ") + [["--force", "-f", "--force-with-lease", "--force-if-includes"]],
        decision = "prompt",
        justification = "Force-pushing rewrites remote history and can drop other agents' or collaborators' commits; confirm the branch and intent first.",
        match = [
            push_command + " --force",
            push_command + " -f",
            push_command + " --force-with-lease",
            push_command + " --force-if-includes",
        ],
        not_match = [
            push_command + " --set-upstream",
            push_command + " --tags",
        ],
    )

# Prompt before force-deleting a git branch.
prefix_rule(
    pattern = [["git"], ["branch"], ["-D"]],
    decision = "prompt",
    justification = "`git branch -D` force-deletes a branch; verify it is merged or intentionally disposable.",
    match = [
        "git branch -D old-work",
    ],
    not_match = [
        "git branch -d merged-work",
        "git branch --list",
    ],
)

# Prompt before discarding worktree changes via `git checkout --`.
prefix_rule(
    pattern = [["git"], ["checkout"], ["--"]],
    decision = "prompt",
    justification = "`git checkout -- <path>` discards worktree changes; inspect the diff and confirm intent first.",
    match = [
        "git checkout -- src/app.ts",
    ],
    not_match = [
        "git checkout main",
        "git checkout -b feature",
    ],
)

# Forbid discarding every worktree change via `git checkout .`.
for checkout_command in ["git checkout", "git checkout --"]:
    prefix_rule(
        pattern = checkout_command.split(" ") + ["."],
        decision = "forbidden",
        justification = "`git checkout .` discards every uncommitted change in the shared worktree, including other agents' work; restore only paths you edited.",
        match = [
            checkout_command + " .",
        ],
        not_match = [
            checkout_command + " src/app.ts",
            "git checkout main",
        ],
    )

# Forbid `git clean`, which deletes untracked files across the shared worktree.
prefix_rule(
    pattern = [["git"], ["clean"]],
    decision = "forbidden",
    justification = "`git clean` deletes untracked files in the shared worktree, including other agents' new files; list candidates with `git status --short` and remove only paths you created.",
    match = [
        "git clean -fd",
        "git clean -fdx",
        "git clean -nd",
    ],
    not_match = [
        "git status --short",
    ],
)

# Prompt before repository-wide history filtering.
prefix_rule(
    pattern = [["git"], ["filter-repo", "filter-branch"]],
    decision = "prompt",
    justification = "History-rewriting git commands need explicit intent and a clean understanding of downstream impact.",
    match = [
        "git filter-repo --path secrets.txt --invert-paths",
        "git filter-branch --tree-filter 'rm secrets.txt'",
    ],
    not_match = [
        "git rebase main",
        "git rebase --continue",
        "git rebase --skip",
        "git rebase --abort",
        "git rebase --quit",
        "git rebase --help",
        "git merge main",
        "git log --oneline",
    ],
)

# Ordinary and interactive rebases have no blanket approval rule.
# Guard risky options immediately after rebase or its interactive flag. Prefix
# matching does not cover arbitrary option order, aliases, or Git config defaults.
for rebase_command in ["git rebase", "git rebase -i", "git rebase --interactive"]:
    prefix_rule(
        pattern = rebase_command.split(" ") + [[
            "--root", "--autostash", "--update-refs",
            "-sours", "--strategy=ours",
            "-Xours", "-Xtheirs", "--strategy-option=ours", "--strategy-option=theirs",
        ]],
        decision = "prompt",
        justification = "Review rebases that rewrite from the root, stash shared work, move other branches, or discard changes through a merge strategy.",
        match = [
            rebase_command + " --root",
            rebase_command + " --autostash main",
            rebase_command + " --update-refs main",
            rebase_command + " -sours main",
            rebase_command + " --strategy=ours main",
            rebase_command + " -Xours main",
            rebase_command + " -Xtheirs main",
            rebase_command + " --strategy-option=ours main",
            rebase_command + " --strategy-option=theirs main",
        ],
        not_match = [
            rebase_command + " main",
            rebase_command + " --onto main old-base feature",
            rebase_command + " --no-autostash main",
            rebase_command + " --no-update-refs main",
            rebase_command + " --strategy=ort main",
        ],
    )
    prefix_rule(
        pattern = rebase_command.split(" ") + [["-s", "--strategy"], ["ours"]],
        decision = "prompt",
        justification = "The ours rebase strategy discards every replayed patch.",
        match = [
            rebase_command + " -s ours main",
            rebase_command + " --strategy ours main",
        ],
        not_match = [
            rebase_command + " -s ort main",
            rebase_command + " --strategy ort main",
        ],
    )
    prefix_rule(
        pattern = rebase_command.split(" ") + [["-X", "--strategy-option"], ["ours", "theirs"]],
        decision = "prompt",
        justification = "Favoring one side automatically discards the other side of conflicting changes.",
        match = [
            rebase_command + " -X ours main",
            rebase_command + " -X theirs main",
            rebase_command + " --strategy-option ours main",
            rebase_command + " --strategy-option theirs main",
        ],
        not_match = [
            rebase_command + " -X find-renames main",
        ],
    )

# Forbid discarding local changes with `git reset --hard`.
prefix_rule(
    pattern = [["git"], ["reset"], ["--hard"]],
    decision = "forbidden",
    justification = "`git reset --hard` discards every uncommitted change in the shared worktree, including other agents' work; revert only paths you edited.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
        "git reset --mixed HEAD~1",
    ],
)

# Forbid discarding every worktree change via `git restore .`.
prefix_rule(
    pattern = [["git"], ["restore"], ["."]],
    decision = "forbidden",
    justification = "`git restore .` discards every uncommitted change in the shared worktree, including other agents' work; restore only paths you edited.",
    match = [
        "git restore .",
    ],
    not_match = [
        "git restore src/app.ts",
        "git restore --staged src/app.ts",
    ],
)

# Prompt before discarding worktree changes via `git restore`.
prefix_rule(
    pattern = [["git"], ["restore"], ["--worktree", "--source"]],
    decision = "prompt",
    justification = "`git restore` can discard worktree changes; inspect the diff and confirm intent first.",
    match = [
        "git restore --worktree src/app.ts",
        "git restore --source HEAD~1 src/app.ts",
    ],
    not_match = [
        "git restore --staged src/app.ts",
        "git diff src/app.ts",
    ],
)
